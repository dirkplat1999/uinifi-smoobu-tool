<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>UnifiSmoobuTool.App</RootNamespace>
    <AssemblyName>UnifiSmoobuTool</AssemblyName>
    <StartupObject>UnifiSmoobuTool.App.Program</StartupObject>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Product>UniFi Access - Smoobu Guest Access Tool</Product>
    <Company>Dirk Plat</Company>
    <Copyright>Copyright (C) Dirk Plat</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="8.0.1" />
    <PackageReference Include="Serilog.Extensions.Hosting" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\UnifiSmoobuTool.Core\UnifiSmoobuTool.Core.csproj" />
    <ProjectReference Include="..\UnifiSmoobuTool.Infrastructure\UnifiSmoobuTool.Infrastructure.csproj" />
  </ItemGroup>

</Project>
