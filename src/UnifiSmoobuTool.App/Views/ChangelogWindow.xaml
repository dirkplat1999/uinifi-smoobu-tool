<Window x:Class="UnifiSmoobuTool.App.Views.ChangelogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Changelog - UniFi Access - Smoobu Guest Access Tool" Height="560" Width="620"
        WindowStartupLocation="CenterOwner" Icon="/Resources/app.ico">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Changelog" FontSize="18" FontWeight="Bold" Margin="0,0,0,12"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,12">
            <TextBlock x:Name="ChangelogText" TextWrapping="Wrap" FontFamily="Consolas"/>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Close" Click="CloseButton_Click" Padding="16,4"/>
        </StackPanel>
    </Grid>
</Window>
