<UserControl x:Class="UnifiSmoobuTool.App.Views.BackupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Margin="8" MaxWidth="640" HorizontalAlignment="Left">
        <TextBlock Text="{Binding StatusMessage}" Margin="0,0,0,16" TextWrapping="Wrap" Opacity="0.8"/>

        <GroupBox Header="Export" Padding="8" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock TextWrapping="Wrap" Margin="0,0,0,8"
                           Text="Saves your settings, message templates, automation webhooks, apartment↔door mappings, and test-mode rules to a single file."/>
                <CheckBox Content="Include credentials (Smoobu API key, UniFi Access token, SMTP password)"
                          IsChecked="{Binding IncludeCredentials}" Margin="0,0,0,8"/>
                <StackPanel Orientation="Horizontal" Visibility="{Binding IncludeCredentials, Converter={StaticResource BoolToVis}}" Margin="0,0,0,8">
                    <TextBlock Text="Passphrase" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <PasswordBox x:Name="ExportPasswordBox" Width="240" PasswordChanged="ExportPasswordBox_PasswordChanged"/>
                </StackPanel>
                <Button Content="Export backup..." Command="{Binding ExportCommand}" Padding="10,4" HorizontalAlignment="Left"/>
            </StackPanel>
        </GroupBox>

        <GroupBox Header="Restore" Padding="8">
            <StackPanel>
                <Button Content="Choose backup file..." Command="{Binding ChooseImportFileCommand}" Padding="10,4" HorizontalAlignment="Left" Margin="0,0,0,8"/>

                <StackPanel Visibility="{Binding PendingImportPreview, Converter={StaticResource NullToVis}}">
                    <TextBlock FontWeight="Bold" Margin="0,0,0,4" Text="Backup contents"/>
                    <TextBlock Text="{Binding PendingImportPreview.CreatedAtUtc, StringFormat='Created: {0:g} UTC'}"/>
                    <TextBlock Text="{Binding PendingImportPreview.TemplateCount, StringFormat='Message templates: {0}'}"/>
                    <TextBlock Text="{Binding PendingImportPreview.WebhookCount, StringFormat='Automation webhooks: {0}'}"/>
                    <TextBlock Text="{Binding PendingImportPreview.ApartmentMappingCount, StringFormat='Apartment mappings: {0}'}"/>
                    <TextBlock Text="{Binding PendingImportPreview.TestModeRuleCount, StringFormat='Test mode rules: {0}'}"/>
                    <TextBlock Text="{Binding PendingImportPreview.HasEncryptedSecrets, StringFormat='Includes encrypted credentials: {0}'}" Margin="0,0,0,8"/>

                    <StackPanel Orientation="Horizontal" Visibility="{Binding PendingImportPreview.HasEncryptedSecrets, Converter={StaticResource BoolToVis}}" Margin="0,0,0,8">
                        <TextBlock Text="Passphrase" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <PasswordBox x:Name="ImportPasswordBox" Width="240" PasswordChanged="ImportPasswordBox_PasswordChanged"/>
                    </StackPanel>

                    <TextBlock TextWrapping="Wrap" Foreground="DarkRed" Margin="0,0,0,8"
                               Text="Importing overwrites your current settings, templates, webhooks, apartment mappings, and test-mode rules."/>
                    <Button Content="Import" Command="{Binding ImportCommand}" Padding="10,4" HorizontalAlignment="Left"/>
                </StackPanel>
            </StackPanel>
        </GroupBox>
    </StackPanel>
</UserControl>
