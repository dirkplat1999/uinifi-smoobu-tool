<Window x:Class="UnifiSmoobuTool.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:UnifiSmoobuTool.App.Views"
        Title="UniFi Access - Smoobu Guest Access Tool" Height="760" Width="1150"
        WindowStartupLocation="CenterScreen">
    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="E_xit" Click="ExitMenuItem_Click"/>
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="_Check for Updates" Click="CheckForUpdatesMenuItem_Click"/>
                <Separator/>
                <MenuItem Header="_About / License" Click="AboutMenuItem_Click"/>
            </MenuItem>
        </Menu>
        <Border DockPanel.Dock="Top" Background="{StaticResource PrimaryBrush}" Padding="18,12">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="UniFi Access" Foreground="White" FontSize="17" FontWeight="SemiBold"/>
                <TextBlock Text=" · Smoobu Guest Access Tool" Foreground="{StaticResource PrimaryLightBrush}" FontSize="17"/>
            </StackPanel>
        </Border>
        <TabControl Margin="8">
            <TabItem Header="Dashboard">
                <views:DashboardView x:Name="DashboardViewControl"/>
            </TabItem>
            <TabItem Header="Apartments">
                <views:ApartmentsView x:Name="ApartmentsViewControl"/>
            </TabItem>
            <TabItem Header="Message Templates">
                <views:TemplatesView x:Name="TemplatesViewControl"/>
            </TabItem>
            <TabItem Header="Automation Webhooks">
                <views:WebhooksView x:Name="WebhooksViewControl"/>
            </TabItem>
            <TabItem Header="Test Mode">
                <views:TestModeView x:Name="TestModeViewControl"/>
            </TabItem>
            <TabItem Header="Settings">
                <views:SettingsView x:Name="SettingsViewControl"/>
            </TabItem>
            <TabItem Header="Backup">
                <views:BackupView x:Name="BackupViewControl"/>
            </TabItem>
            <TabItem Header="Logs">
                <views:LogViewerView x:Name="LogViewerViewControl"/>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
